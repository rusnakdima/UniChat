@startuml spec-oauth-flow
title UniChat — OAuth 2.0 + PKCE Loopback Flow (contracts UC-10..UC-12)

skinparam sequenceMessageAlign center
autonumber "<b>0."

participant "Frontend" as FE
participant "OAuthService" as O
participant "AuthStateService" as S
participant "LoopbackListener\n(127.0.0.1:3456)" as L
participant "Provider\n(Twitch|Kick|YouTube)" as P
participant "TokenVaultService" as V

== start_auth(platform) ==
FE -> O : auth_start(platform)
O -> L : start_listener(platform_key, host, port, path)\nfrom redirect_uri (one-shot TCP accept)
O -> S : create_session()
S --> O : { state: random(32),\ncode_verifier: random(64) }  // TTL 600 s
O -> O : authorize URL = client_id, redirect_uri,\nresponse_type=code, scope (joined), state,\ncode_challenge=S256(verifier),\ncode_challenge_method=S256
O --> FE : authorize URL (open externally)
note over P, L : YouTube exchanges with client_secret instead of PKCE

== provider consent ==
FE -> P : open authorize URL
P -> L : GET {path}?code=…&state=…  (single connection, ≤4096 B)
alt path mismatch
  L --> P : HTTP 400 "Authorization callback is invalid."
else match
  L --> P : HTTP 200 "Authorization completed…"
  L -> O : forward full callback URL (mpsc)
end

== wait_for_callback / complete_auth ==
FE -> O : auth_await_callback(platform)   // budget 240 s
FE -> O : auth_complete(params)
alt params.error present
  O --> FE : error "<code>: <description>"
else code + state present
  O -> S : consume_session(state)
  alt missing or expired (>600 s)
    S --> O : error ("oauth state is missing" | "oauth state expired")
  else ok
    O -> P : POST token_url: client_id, code, redirect_uri,\ngrant_type=authorization_code [, code_verifier]
    P --> O : access_token, refresh_token, expires_in
    O -> P : identity fetch — Kick GET public/v1/users (Bearer);\nTwitch Helix /users (+Client-Id); Google userinfo
    O -> V : save_token(account, token)
    V -> V : keyring "unichat", key oauth-{platform}-{account_id}\nJSON AccountVaultRecord{account, token}; cache warm;\nupdate per-platform account index
    O --> FE : connected account
  end
end

== maintenance ==
FE -> O : auth_refresh → token_url grant_type=refresh_token\n(+ client_secret for YouTube) → vault update
FE -> O : auth_disconnect → revoke at provider revoke_url,\nthen delete vault entry + index entry
FE -> O : auth_status / auth_validate → vault read + expiry check

note over V
  Vault record shape (camelCase):
  { account: AuthAccountModel,
    token: OAuthTokenModel }
  Cache: RwLock<HashMap<"{platform}-{id}", record>>
end note
@enduml
