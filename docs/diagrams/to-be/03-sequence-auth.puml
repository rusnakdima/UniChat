@startuml unichat-tobe-sequence-auth
' Generated by /arch-diagrams — DO NOT EDIT BY HAND

title UniChat — TO-BE Auth Flow (KAS + WebSocket)

note as migration_note
  **MIGRATION: Tauri invoke → tauri_plugin_mcp_bridge WebSocket**
  All IPC through WebSocket, KAS handlers replace commands
end note

actor User
participant "Dioxus Frontend" as FE
participant "mcp_bridge_client\n(signals)" as Client
participant "tauri_plugin_mcp_bridge\n(WebSocket)" as Bridge
participant "KAS Handler\n#[kas_handler]" as Handler
participant "AuthApplicationService" as AuthSvc
participant "TokenVaultService" as TokenVault
participant "Twitch IRC" as IRC

== OAuth Flow (Migrated) ==

User -> FE : Click "Connect Twitch"
FE -> Client : auth_start_signal.set({platform: "twitch"})
Client -> Bridge : WS: auth_start_handler {platform}
Bridge -> Handler : kas_handler::invoke(auth_start, args)
Handler -> AuthSvc : start_oauth_flow(platform)
AuthSvc -> TokenVault : generate_verifier()
TokenVault --> AuthSvc : verifier, redirect_url
AuthSvc --> Handler : OAuthRedirectUrl
Handler --> Bridge : InvokeResult {redirect_url}
Bridge --> Client : {redirect_url}
Client --> FE : redirect_url signal
FE -> FE : window.location.href = redirect_url

== OAuth Callback (Migrated) ==

Browser -> FE : OAuth callback
FE -> Client : auth_callback_signal.set({code, verifier})
Client -> Bridge : WS: auth_callback_handler {code, verifier}
Bridge -> Handler : kas_handler::invoke(auth_callback, args)
Handler -> AuthSvc : complete_oauth(code, verifier)
AuthSvc -> TokenVault : exchange_code(code, verifier)
TokenVault -> TwitchAPI : POST /oauth2/token
TwitchAPI --> TokenVault : tokens
TokenVault --> AuthSvc : tokens
AuthSvc --> Handler : ChatAccountEntity
Handler --> Bridge : InvokeResult
Bridge --> Client : {account}
Client --> FE : accounts_signal.update()

== IRC Join (Migrated) ==

User -> FE : Join channel button
FE -> Client : join_channel_signal.set({channel})
Client -> Bridge : WS: irc_join_handler {channel}
Bridge -> Handler : kas_handler::invoke(irc_join, args)
Handler -> IRC : join(channel)
IRC --> Handler : joined
Handler --> Bridge : InvokeResult
Bridge --> Client : {success}
Client --> FE : connection status signal

== Message Receive (Migrated) ==

IRC -> Handler : PRIVMSG #channel user: msg
Handler -> AuthSvc : validate_message(user)
AuthSvc --> Handler : ChatMessage
Handler -> Bridge : WS broadcast {type: "chat_message", data}
Bridge --> Client : chat_message event
Client -> FE : messages_signal.append(message)
FE -> FE : re-render chat list

== Overlay Config (Migrated) ==

User -> FE : Change overlay settings
FE -> Client : overlay_config_signal.set(settings)
Client -> Bridge : WS: overlay_config_set_handler {settings}
Bridge -> Handler : kas_handler::set(overlay_config, settings)
Handler --> Bridge : SetResult
Bridge --> Client : ack
Client -> FE : overlay updated

note "WebSocket bidirectional\nAll state changes via KAS set\nToast notifications via KAS toast" as ws_note

@enduml
