@startuml spec-overlay-broadcast
title UniChat — Overlay Server Broadcast Pipeline (contracts UC-50..UC-52)

skinparam activityBackgroundColor White

start
:bind TcpListener on OVERLAY_SERVER_PORT (1450);
:build router:
GET /overlay → dist index.html + forced transparent CSS
GET /ws/overlay?widget_id=… → WS upgrade (subscriber | source)
GET /api/overlay/{widget}/config → widget config JSON
GET /api/overlay/{widget}/messages → cached messages;

fork
  partition "OBS subscriber" {
    :accept WS; filter = All, channelIds = None;
    while (frame within WS_RECEIVE_TIMEOUT_SECS = 30?) is (yes)
      if (Close/Error/idle-timeout?) then (yes)
        :remove subscriber by id; end connection;
        stop
      elseif (Ping?) then (reply Pong)
        :reply Pong;
      else (Text frame)
        if (already subscribed? or type != "subscribe"?) then (yes)
          :ignore frame;
        else (no)
          :apply subscribe { filter: all|supporters,
          channelIds?: string[] };
          :register under widget_id;
        endif
      endif
    endwhile (timeout → ping; close/error → remove subscriber)
  }
fork again
  partition "Message source (frontend)" {
    while (WS open?) is (yes)
      :Text frame JSON { type, message? };
      if (type == "chatMessage"?) then (yes)
        :sanitize_for_overlay(text):
        strip URLs (BEFORE escaping) → escape HTML (& < > " ') → trim → cap MAX_LEN = 260;
        :build OverlayMessageModel (camelCase);
        :persist to per-widget cache — push to map[widget_id], cap MESSAGE_MAX_PER_WIDGET = 100 (drop oldest), map cap MAX_WIDGET_IDS = 100 (evict first widget's bucket when full);
        :broadcast_message(msg): deliver to each subscriber where
        filter == All or msg.is_supporter,
        and channelIds empty-or-contains platform:source_channel_id;
      endif
    endwhile (no)
  }
end fork

note right
  Frontend commands:
  start_overlay_server(port) · stop_overlay_server · open_overlay_window
  emit_overlay_config_changed · init_overlay_config_from_storage
  get_overlay_config(widget_id) · get_overlay_messages(widget_id)
end note
stop
@enduml
