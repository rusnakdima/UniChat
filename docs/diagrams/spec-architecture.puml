@startuml spec-architecture
title UniChat — Target Architecture (derived from Tauri master 01e52b2)

skinparam componentStyle rectangle

actor "Viewer / Streamer" as User
actor "OBS Browser Source" as OBS

package "Presentation (Angular → Dioxus webapp)" {
  [Dashboard] as Dash
  [Connections] as Conn
  [Analytics / Export] as Analytics
  [Overlay Management] as OvlMgmt
  [Settings / About / Shortcuts] as SettingsUI
}

package "IPC surface (Tauri commands)" {
  [auth_*] as AuthCmd
  [twitch_irc_*] as IrcCmd
  [twitch_* helix/icons] as HelixCmd
  [kick_* / youtube_*] as RestCmd
  [overlay_*] as OverlayCmd
  [crud_execute + per-entity CRUD] as CrudCmd
  [check/download/install_update] as UpdateCmd
  [storage_*] as KvCmd
}

package "Application services" {
  [OAuthService + AuthStateService] as OAuth
  [AccountService] as AcctSvc
  [TokenVaultService] as Vault
  [CrudService (nosql_orm)] as Crud
  [OverlayServer orchestrator] as OvlOrch
  [Update services (api/downloader/installer/platform)] as Upd
}

package "Infrastructure adapters" {
  [Twitch IRC WS client\nwss://irc-ws.chat.twitch.tv:443] as IrcWs
  [Loopback HTTP listener\nCALLBACK_PORT 3456] as Loopback
  [Helix REST client] as Helix
  [Kick REST client\napi.kick.com + kick.com fallbacks] as KickApi
  [YouTube Data v3 client] as YtApi
  [keyring "unichat"] as Keyring
  database "JsonProvider store\n(app_data_dir/unichat_db):\nchat_messages, chat_accounts,\nchat_channels, custom_emotes,\ndashboard_preferences" as OrmDB
  [Axum overlay server\n127.0.0.1:1450] as Axum
  [GitHub releases client] as GhRel
}

User --> Dash
User --> Conn
User --> Analytics
User --> OvlMgmt
User --> SettingsUI

Dash --> CrudCmd
Dash --> IrcCmd
Conn --> AuthCmd
OvlMgmt --> OverlayCmd
SettingsUI --> UpdateCmd
SettingsUI --> KvCmd

AuthCmd --> OAuth
AuthCmd --> AcctSvc
IrcCmd --> IrcWs
HelixCmd --> Helix
RestCmd --> KickApi
RestCmd --> YtApi
OverlayCmd --> OvlOrch
CrudCmd --> Crud
UpdateCmd --> Upd
KvCmd --> Crud

OAuth --> Loopback
OAuth --> Vault
AcctSvc --> Vault
Vault --> Keyring
OvlOrch --> Axum
Upd --> GhRel

Crud --> OrmDB
IrcWs --> Dash : event "twitch-message"
Axum <--> OBS : GET /overlay, /api/overlay/*\nWS /ws/overlay (subscribe | chatMessage)
@enduml
