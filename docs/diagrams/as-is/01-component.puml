@startuml unichat-component
' Generated by /arch-diagrams — DO NOT EDIT BY HAND

skinparam componentStyle rectangle

title UniChat — AS-IS Component Architecture

package "Frontend (Angular 17+ Standalone)" {
  [app.ts] <<root>>
  [app.routes.ts]

  package "pages/" {
    [dashboard-page/]
    [connections-page/]
    [overlay-page/]
    [settings-page/]
    [chat-page/]
  }

  package "components/" {
    [dashboard/]
    [chat-message-card/]
    [chat-scroll-region/]
    [emote-picker/]
    [app-sidebar/]
    [30+ components]
  }

  package "services/" {
    [api.service.ts]
    [crud.service.ts]
    [authorization/]
    [dashboard-state/]
    [ui/]
    [30+ services]
  }

  package "entities/" {
    [ChatMessage]
    [ChatAccount]
    [ChatChannel]
    [PlatformType]
    [AuthStatus]
  }
}

package "Tauri IPC" {
  [tauri_plugin_mcp_bridge] <<WebSocket>>
  [tauri_plugin_opener]
  [tauri_plugin_deep_link]
  [tauri_plugin_shell]
}

package "Rust Backend (src-tauri)" {
  package "commands/" {
    [auth-provider.command]
    [chat-account.command]
    [chat-channel.command]
    [chat-message.command]
    [chat.command] (kick, twitch, youtube)
    [custom-emote.command]
    [dashboard-preferences.command]
    [icons.command]
    [overlay.command]
    [storage.command]
    [twitch-irc.command]
    [update.command]
    [crud_command]
  }

  package "services/" {
    [AccountService]
    [CrudService]
    [OverlayServerService]
    [TwitchIrcService]
    [TwitchService]
    [OAuthService]
    [TokenVaultService]
    [AuthStateService]
    [UpdateService]
  }

  package "entities/" {
    [ChatAccountEntity]
    [ChatChannelEntity]
    [ChatMessageEntity]
    [CustomEmoteEntity]
    [DashboardPreferencesEntity]
    [Response<T>]
  }

  package "models/" {
    [PlatformTypeModel]
    [AuthAccountModel]
    [OAuthPendingSessionModel]
    [OverlayMessageModel]
  }

  package "platform/" {
    [twitch/]
    [kick/]
    [youtube/]
  }
}

package "dioxus-shared" {
  [SignalStore]
  [ThemeVariant]
}

package "External Services" {
  [Twitch IRC] <<websocket>>
  [Kick API] <<REST>>
  [YouTube API] <<REST>>
  [nosql_orm] <<JSON storage>>
}

' Frontend connections
app.ts --> app.routes.ts
api.service.ts --> tauri_plugin_mcp_bridge
crud.service.ts --> tauri_plugin_mcp_bridge

' Command connections
ChatAccountEntity <-- chat-account.command
ChatChannelEntity <-- chat-channel.command
ChatMessageEntity <-- chat-message.command
CustomEmoteEntity <-- custom-emote.command
DashboardPreferencesEntity <-- dashboard-preferences.command

' Services
AccountService --> ChatAccountEntity
CrudService --> nosql_orm
OverlayServerService --> overlay.command
TwitchIrcService --> twitch-irc.command

' Platform integrations
TwitchService --> Twitch IRC
TwitchService --> Twitch API
TwitchIrcService --> Twitch IRC

' State
AppState --> AccountService
AppState --> CrudService
AppState --> OverlayServerService
AppState --> TwitchIrcService

@enduml
