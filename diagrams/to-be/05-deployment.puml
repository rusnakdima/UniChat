@startuml unichat-tobe-deployment
' Generated by /arch-diagrams — DO NOT EDIT BY HAND

skinparam componentStyle rectangle

title UniChat — TO-BE Deployment (Post-Migration)

note as migration_note
  **MIGRATION SUMMARY:**
  Angular → Dioxus RSX (src/)
  83 Tauri commands → KAS handlers
  AppState → Dioxus signals
  tauri_plugin_mcp_bridge WebSocket IPC
end note

package "Desktop App (Tauri v2)" {
  package "Dioxus Frontend Process (src/)" {
    [main.tsx]
    [App.tsx]

    package "pages/" {
      [dashboard_page.rsx]
      [connections_page.rsx]
      [overlay_page.rsx]
      [settings_page.rsx]
      [chat_page.rsx]
    }

    package "components/" {
      [chat_message_card.rsx]
      [chat_scroll_region.rsx]
      [emote_picker.rsx]
      [app_sidebar.rsx]
      [dashboard.rsx]
    }

    package "signals/" {
      [chat_accounts_signal]
      [chat_messages_signal]
      [platform_sessions_signal]
      [overlay_config_signal]
      [theme_signal]
    }

    package "hooks/" {
      [use_auth.rs]
      [use_chat.rs]
      [use_overlay.rs]
    }

    [mcp_bridge_client.ts] as client
  }
}

package "Tauri IPC (WebSocket only)" {
  [tauri_plugin_mcp_bridge] <<WebSocket bridge>>
  note right of tauri_plugin_mcp_bridge
    Thin IPC layer only
    All business logic in Rust
  end note
}

package "Rust Backend (src-tauri/)" {
  package "handlers/ (NEW - replaces commands/)" {
    package "invoke/" {
      [auth/]
      [chat_account/]
      [chat_channel/]
      [chat_message/]
      [overlay/]
      [twitch_irc/]
    }
    package "navigate/" {
      [dashboard_nav_handler]
      [connections_nav_handler]
      [overlay_nav_handler]
      [settings_nav_handler]
    }
    package "set/" {
      [chat_state_set_handler]
      [overlay_config_set_handler]
    }
    package "toast/" {
      [message_toast_handler]
      [error_toast_handler]
    }
    package "modal/" {
      [confirm_disconnect_modal]
      [emote_picker_modal]
    }
  }

  package "domain/" {
    [entities/]
    [value_objects/]
    [services/]
    [repositories/]
  }

  package "application/" {
    [AuthApplicationService]
    [ChatApplicationService]
    [OverlayApplicationService]
  }

  package "infrastructure/" {
    [repositories/]
    [adapters/]
    [TwitchIrcService]
    [OverlayServerService]
  }
}

package "dioxus-shared" {
  [ThemeVariant]
  [DynamicRenderer]
  [SignalStore]
  [Schema]
  [Algorithms]
}

package "Platform Services" {
  [Twitch IRC\n(WebSocket)] as TwitchIRC
  [Twitch API\n(REST)] as TwitchAPI
  [Kick API\n(REST)] as KickAPI
  [YouTube API\n(REST)] as YTAPI
}

package "nosql_orm" {
  [JSON Storage]
}

' Connections
App.tsx --> dashboard_page.rsx
App.tsx --> connections_page.rsx

signals/ --> mcp_bridge_client
mcp_bridge_client --> tauri_plugin_mcp_bridge

tauri_plugin_mcp_bridge --> handlers/
handlers/ --> application/
application/ --> domain/
domain/ --> infrastructure/

infrastructure/ --> nosql_orm
infrastructure/ --> TwitchIRC
infrastructure/ --> TwitchAPI
infrastructure/ --> KickAPI
infrastructure/ --> YTAPI

infrastructure/ --> dioxus-shared

note "MIGRATION ARROW" as arrow
arrow: Angular -->> Dioxus : migrate UI

note "KAS replaces\n83 #[tauri::command]\nfunctions" as kas_note
kas_note .. handlers/

@enduml
