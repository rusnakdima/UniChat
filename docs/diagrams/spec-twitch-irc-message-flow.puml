@startuml spec-twitch-irc-message-flow
title UniChat — Twitch IRC Connection & Message Flow (contracts UC-20..UC-22)

skinparam sequenceMessageAlign center
autonumber "<b>0."

participant "Frontend" as FE
participant "TwitchIrcService" as S
participant "wss://irc-ws.chat.twitch.tv:443" as TW
queue "mpsc::channel(100)\n(outgoing)" as Q

== join_channel(channel_id, channel_name, username, token) ==
FE -> S : twitch_irc_join_channel
S -> S : key = "{channel_id}:{channel_name}"
alt key already in registry
  S --> FE : Ok (no-op "Already connected")
else new
  S -> Q : create; register connection under key
  S -> TW : connect_async (tokio spawn)
  alt connect failure
    S -> S : remove registry entry; log error; task ends
  else connected
    S -> TW : "CAP REQ :twitch.tv/tags twitch.tv/commands twitch.tv/membership\\r\\n"
    S -> TW : "PASS oauth:{token}\\r\\n"
    S -> TW : "NICK {username lowercased}\\r\\n"
    S -> TW : "JOIN #{channel_name lowercased}\\r\\n"
    note right of TW : any send failure ⇒ teardown + registry removal

    loop tokio::select! over read loop / outgoing channel
      TW -> S : text frame
      alt frame contains "PING"
        S -> TW : same frame with PING→PONG replaced
      else PRIVMSG match :(.+)!.+@.+\.tmi\.twitch\.tv PRIVMSG #(.+) :(.+)
        S -> S : parse IRCv3 tags (first "@…" to next space):
        note right of S
          badges → TwitchBadge{setId,id,version}
          color  → hex or default #FFFFFF
          user-id → author_id
          emotes → id:positions + CDN url
                   static-cdn.jtvnw.net/emoticons/v2/{id}/default/light/1.0
          mod=1 / subscriber=1 → flags
        end note
        S -> S : build TwitchChatMessage { id: "twitch-{chan}-{user}-{ts_ms}", platform:"twitch", author, authorId, text, timestamp: now_ms, badges, color, emotes, isMod, isSubscriber, isHighlighted:false }
        S -> S : drop silently
      end
      Q -> S : outgoing text (if any)
      S -> TW : send raw line
    end

    TW -> S : Close / error / stream end
    S -> S : remove registry entry; log disconnect
  end
end

== send_message ==
FE -> S : twitch_irc_send_message(channel_id, channel_name, msg)
alt not connected for key
  S --> FE : Err("Not connected to channel")
else connected
  S -> Q : "PRIVMSG #{channel lowercased} :{msg}\\r\\n"
end

== leave_channel ==
FE -> S : twitch_irc_leave_channel
S -> Q : "QUIT\\r\\n"; remove registry entry
@enduml
