{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "packageManager": "bun",
    "analytics": false
  },
  "projects": {
    "unichat": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/unichat",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets"
            ],
            "styles": [
              "@tauri-front/shared/styles/themes/m3/tokens.css",
              "@tauri-front/shared/styles/themes/m3/components.css",
              "@tauri-front/shared/styles/themes/glassmorphism/tokens.css",
              "@tauri-front/shared/styles/themes/glassmorphism/components.css",
              "@tauri-front/shared/styles/themes/neumorphism/tokens.css",
              "@tauri-front/shared/styles/themes/neumorphism/components.css",
              "@tauri-front/shared/styles/themes/claymorphism/tokens.css",
              "@tauri-front/shared/styles/themes/claymorphism/components.css",
              "@tauri-front/shared/styles/themes/brutalism/tokens.css",
              "@tauri-front/shared/styles/themes/brutalism/components.css",
              "@tauri-front/shared/styles/themes/skeuomorphism/tokens.css",
              "@tauri-front/shared/styles/themes/skeuomorphism/components.css",
              "@tauri-front/shared/styles/ui-system.css"
            ],
            "scripts": [
              "node_modules/flowbite/dist/flowbite.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "100kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 1426,
            "host": "0.0.0.0"
          },
          "configurations": {
            "production": {
              "buildTarget": "unichat:build:production"
            },
            "development": {
              "buildTarget": "unichat:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
