@startuml unichat-sequence-auth
' Generated by /arch-diagrams — DO NOT EDIT BY HAND

title UniChat — AS-IS Auth Flow (OAuth + Tauri)

actor User
participant "Angular Frontend" as FE
participant "Tauri IPC" as Tauri
participant "auth_start\n#[tauri::command]" as auth_start_cmd
participant "auth_await_callback\n#[tauri::command]" as auth_cb_cmd
participant "AccountService" as AccountSvc
participant "TokenVaultService" as TokenVault
participant "Twitch IRC" as IRC
participant "nosql_orm" as DB

note right of FE
  UniChat supports Twitch, Kick, YouTube
  Each platform has its own OAuth flow
end note

== OAuth Start Flow ==

User -> FE : Click "Connect Twitch"
FE -> Tauri : invoke("auth_start", {platform: "twitch"})
Tauri -> auth_start_cmd : auth_start(platform)
auth_start_cmd -> AccountSvc : start_oauth_flow(platform)
AccountSvc -> TokenVault : generate_verifier()
TokenVault --> AccountSvc : verifier
AccountSvc --> auth_start_cmd : OAuthRedirectUrl
auth_start_cmd --> Tauri : {redirect_url}
Tauri --> FE : redirect_url
FE -> FE : window.location.href = redirect_url

== OAuth Callback Flow ==

Browser -> FE : OAuth callback with code
FE -> Tauri : invoke("auth_await_callback", {platform, code, verifier})
Tauri -> auth_cb_cmd : auth_await_callback(platform, code, verifier)
auth_cb_cmd -> AccountSvc : complete_oauth(platform, code, verifier)
AccountSvc -> TokenVault : exchange_code(code, verifier)
TokenVault -> Twitch : POST /oauth2/token
Twitch --> TokenVault : access_token, refresh_token
TokenVault --> AccountSvc : tokens
AccountSvc -> DB : persist ChatAccountEntity
AccountSvc --> auth_cb_cmd : ChatAccountEntity
auth_cb_cmd --> Tauri : Response<ChatAccountEntity>
Tauri --> FE : account created

== IRC Connection Flow ==

FE -> Tauri : invoke("twitch_irc_join_channel", {channel})
Tauri -> TwitchIrcService : join_channel(channel)
TwitchIrcService -> IRC : CONNECT irc.chat.twitch.net
IRC --> TwitchIrcService : CONNECTED
TwitchIrcService --> Tauri : Ok
Tauri --> FE : joined

== Message Receive Flow ==

IRC -> TwitchIrcService : PRIVMSG #channel user: message
TwitchIrcService -> AccountSvc : validate_message(user)
AccountSvc --> TwitchIrcService : ChatMessageEntity
TwitchIrcService --> Tauri : emit("chat_message", ChatMessageEntity)
Tauri --> FE : chat_message event
FE -> FE : append to chat list

== Overlay Server Flow ==

FE -> Tauri : invoke("start_overlay_server")
Tauri -> OverlayServerService : start(port)
OverlayServerService -> OverlayServerService : bind axum WS server
OverlayServerService --> Tauri : server_started
Tauri --> FE : {ws_url}
FE -> FE : connect to overlay WS

@enduml
