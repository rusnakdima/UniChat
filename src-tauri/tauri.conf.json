{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unichat",
  "version": "0.4.0",
  "identifier": "com.tcs.unichat",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5177",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "unichat",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 400,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["unichat"]
      }
    }
  }
}
